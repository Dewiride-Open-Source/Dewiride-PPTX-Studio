{
  "name": "dewiride-pptx-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source web PowerPoint renderer and layout-aware editor",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dewiride-Open-Source/Dewiride-PPTX-Studio.git"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.cli.json && tsc --noEmit -p apps/studio/tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tools/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "plan": "node tools/repo/plan-status.ts",
    "structure": "node tools/repo/check-structure.ts",
    "layering": "node tools/repo/layering/check-layering.ts",
    "references": "node tools/repo/adr-index.ts --check && node tools/repo/plan-status.ts --check && node tools/repo/check-links.ts",
    "corpus": "node tools/corpus/manifest/check-corpus.ts",
    "roundtrip": "node tools/corpus/roundtrip/check-roundtrip.ts",
    "gate1": "node tools/gate1/run-gate1.ts",
    "gate2": "node tools/gate2/run-gate2.ts",
    "pkg:qa": "turbo run pkg:qa",
    "check": "pnpm structure && pnpm layering && pnpm references && pnpm corpus && pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm roundtrip && pnpm fidelity && pnpm gate2 && pnpm pkg:qa && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "browsers": "playwright install chromium",
    "fidelity": "node tools/fidelity/fidelity.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
