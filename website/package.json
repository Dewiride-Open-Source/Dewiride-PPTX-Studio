    "@pptx-studio/geometry": "^0.1.1",
    "@pptx-studio/model": "^0.2.0",
    "@pptx-studio/opc": "^0.1.1",
    "@pptx-studio/paint": "^0.4.0",
    "@pptx-studio/render-dom": "^0.3.3",
    "@pptx-studio/render-svg": "^0.6.1",
    "@pptx-studio/text": "^0.2.0",
    "@pptx-studio/validate": "^0.2.0",
    "@pptx-studio/writer": "^0.1.2",
    "@pptx-studio/xml": "^0.1.1",
    "fumadocs-core": "16.15.9",
