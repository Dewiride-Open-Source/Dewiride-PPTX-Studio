{
  "name": "pptx-studio-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The public site for @pptx-studio: documentation and a live demo of every published package, installed from npm.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node prerender/decks.mjs && node prerender/reference.mjs",
