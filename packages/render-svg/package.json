{
  "name": "@pptx-studio/render-svg",
  "version": "0.1.0",
  "description": "Slides to SVG: transforms, geometry, fills, strokes and effects, as a string",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dewiride-Open-Source/Dewiride-PPTX-Studio.git",
    "directory": "packages/render-svg"
  },
  "homepage": "https://github.com/Dewiride-Open-Source/Dewiride-PPTX-Studio/tree/main/packages/render-svg#readme",
  "bugs": "https://github.com/Dewiride-Open-Source/Dewiride-PPTX-Studio/issues",
  "keywords": [
    "ooxml",
    "pptx",
    "powerpoint",
    "svg",
    "renderer",
    "drawingml"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "pkg:qa": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@pptx-studio/geometry": "workspace:^",
    "@pptx-studio/model": "workspace:^",
    "@pptx-studio/paint": "workspace:^",
    "@pptx-studio/text": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
