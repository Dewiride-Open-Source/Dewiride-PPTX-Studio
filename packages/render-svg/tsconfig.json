{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    // Workspace dependencies resolve to **source**, so linting and editors
    // never wait for a build. See packages/census/tsconfig.json for why this
    // does not change what is published.
    "paths": {
      "@pptx-studio/geometry": ["../geometry/src/index.ts"],
      "@pptx-studio/model": ["../model/src/index.ts"],
      "@pptx-studio/opc": ["../opc/src/index.ts"],
      "@pptx-studio/paint": ["../paint/src/index.ts"],
      "@pptx-studio/xml": ["../xml/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
