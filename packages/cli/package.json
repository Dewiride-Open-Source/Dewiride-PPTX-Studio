{
  "name": "@pptx-studio/cli",
  "version": "0.0.0",
  "description": "Command line tools for PPTX packages: inspect a deck, validate it, prove a round trip, and bisect the change that breaks it",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dewiride-Open-Source/Dewiride-PPTX-Studio.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Dewiride-Open-Source/Dewiride-PPTX-Studio/tree/main/packages/cli#readme",
  "bugs": "https://github.com/Dewiride-Open-Source/Dewiride-PPTX-Studio/issues",
  "keywords": [
    "pptx",
    "ooxml",
    "cli",
    "inspect",
    "validate",
    "roundtrip",
    "bisect",
    "delta-debugging",
    "powerpoint"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "bin": {
    "pptx-studio": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "pkg:qa": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@pptx-studio/census": "workspace:^",
    "@pptx-studio/opc": "workspace:^",
    "@pptx-studio/validate": "workspace:^",
    "@pptx-studio/xml": "workspace:^",
    "@pptx-studio/writer": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
