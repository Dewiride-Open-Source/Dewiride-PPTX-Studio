{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    // Workspace dependencies resolve to **source**, so linting and editors
    // never wait for a build. See packages/census/tsconfig.json for why this
    // does not leak sibling code into the published bundle.
    "paths": {
      "@pptx-studio/opc": ["../opc/src/index.ts"],
      "@pptx-studio/validate": ["../validate/src/index.ts"],
      "@pptx-studio/xml": ["../xml/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
