{
  "name": "@pptx-studio/geometry",
  "version": "0.1.1",
  "description": "DrawingML preset and custom geometry: the 187 preset shapes, the formula evaluator, arcs",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dewiride-Open-Source/Dewiride-PPTX-Studio.git",
    "directory": "packages/geometry"
  },
  "homepage": "https://github.com/Dewiride-Open-Source/Dewiride-PPTX-Studio/tree/main/packages/geometry#readme",
  "bugs": "https://github.com/Dewiride-Open-Source/Dewiride-PPTX-Studio/issues",
  "keywords": [
    "ooxml",
    "drawingml",
    "geometry",
    "preset-shapes",
    "office-open-xml"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets/*.gen.js": {
      "types": "./dist/presets/*.gen.d.ts",
      "default": "./dist/presets/*.gen.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "pkg:qa": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
