{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // No `paths` here on purpose: tsdown reads this config, and a paths block
    // would make it inline sibling packages' types into the published .d.ts
    // instead of leaving them as external imports.
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
